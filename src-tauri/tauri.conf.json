{
  "productName": "Lead Scraper",
  "version": "0.5.0",
  "identifier": "com.leadscraper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lead Scraper 0.5.0",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/scraper-sidecar"
    ],
    "resources": {
      "binaries/ms-playwright/": "ms-playwright/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMzcyRkZGN0E0NzYzOUQKUldTZFkwZDYveTgzclY0M0JXWVdIUnl1ckppT3RJR0NYaUh6VGFIOEt6a0FvbEJvTFdnN2krQVIK",
      "endpoints": [
        "https://github.com/eduardocicutti/leadscraper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
